{
  "name": "daily-deck-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:supabase": "playwright test -c playwright.supabase.config.ts",
    "test:supabase-build": "node scripts/verify-supabase-build.mjs",
    "test:auth": "playwright test -c playwright.auth.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.x"
  }
}
